# Mombasa Ni Yetu Polls - environment
# Copy to .env for local use, or paste into your host's environment settings.
# NEVER commit a filled-in copy of this file.

NODE_ENV=production
PORT=3000

# ---- Secrets (REQUIRED in production) -------------------------------------
# Generate all three with:  npm run keys -- "YourStrongAdminPassword"
DATA_ENCRYPTION_KEY=
COOKIE_SECRET=
HASH_PEPPER=

# ---- Administrator ---------------------------------------------------------
ADMIN_USER=admin
# scrypt hash produced by `npm run keys`. Never store the plain password here.
ADMIN_PASSWORD_HASH=

# ---- Storage ---------------------------------------------------------------
# Set DATABASE_URL to use Postgres (recommended on managed hosts).
# Leave it empty to use the built-in SQLite file at SQLITE_PATH.
DATABASE_URL=
SQLITE_PATH=./data/polls.db

# ---- Poll behaviour --------------------------------------------------------
POLL_HOURS=24
RETENTION_DAYS=30
# Start the 24-hour window automatically the first time the server boots.
# Leave false and press "Start 24-hour poll" in /admin when you are ready.
AUTO_START_POLL=false

# ---- Anti-fraud ------------------------------------------------------------
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_VOTES=5
MAX_VOTES_PER_IP=25

# ---- Optional: phone OTP verification --------------------------------------
# Off by default. Set OTP_ENABLED=true to require a phone code before voting.
OTP_ENABLED=false
# console | africastalking | twilio
OTP_PROVIDER=console
OTP_TTL_MS=600000
OTP_MAX_ATTEMPTS=5

AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Optional: hCaptcha ----------------------------------------------------
CAPTCHA_ENABLED=false
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
